              <li><a href="/trust#security" class="text-decoration-none text-secondary"><i class="fa-solid fa-angle-right me-1 text-info small"></i> Secure Payments & Privacy</a></li>
              <li><a href="/privacy" class="text-decoration-none text-secondary"><i class="fa-solid fa-angle-right me-1 text-info small"></i> Privacy Policy</a></li>
              <li><a href="/terms" class="text-decoration-none text-secondary"><i class="fa-solid fa-angle-right me-1 text-info small"></i> Terms of Service</a></li>
