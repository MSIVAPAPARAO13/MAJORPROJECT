    <div class="d-flex flex-wrap justify-content-center gap-3">
      <a href="/listings" class="btn btn-light text-danger fw-bold rounded-pill px-4 py-2" id="cta-explore-btn"><i class="fa-solid fa-compass me-2"></i>Explore Stays</a>
      <a href="/login" class="btn btn-outline-light fw-semibold rounded-pill px-4 py-2" id="cta-login-btn"><i class="fa-solid fa-right-to-bracket me-2"></i>Login</a>
    </div>
  </div>
</section>
