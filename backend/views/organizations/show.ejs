<% layout('layouts/boilerplate') %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      
      <!-- Organization Header Card -->
      <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
          <div class="d-flex align-items-center gap-3">
            <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-circle">
              <i class="fa-solid fa-building fa-2x"></i>
            </div>
            <div>
              <h2 class="fw-bold mb-1"><%= organization.name %></h2>
              <p class="text-muted small mb-0">
                <i class="fa-solid fa-location-dot text-danger me-1"></i> <%= organization.address || "Global Portfolio" %> &bull; 
                <i class="fa-solid fa-envelope text-primary me-1 ms-2"></i> <%= organization.contactEmail || "N/A" %> &bull;
                <i class="fa-solid fa-phone text-success me-1 ms-2"></i> <%= organization.phone || "N/A" %>
              </p>
            </div>
          </div>
          <div>
            <a href="/dashboard" class="btn btn-outline-secondary rounded-pill px-4 me-2">Owner Dashboard</a>
            <a href="/listings/new" class="btn btn-danger rounded-pill px-4 shadow-sm">+ Add Property</a>
          </div>
        </div>

        <% if (organization.description) { %>
          <hr class="my-4 opacity-25">
          <p class="text-secondary mb-0" style="line-height: 1.7;"><%= organization.description %></p>
        <% } %>
      </div>

      <!-- Properties Under Organization -->
      <div class="mb-3 d-flex align-items-center justify-content-between">
        <h4 class="fw-bold mb-0">Properties in this Portfolio (<%= properties.length %>)</h4>
      </div>

      <% if (properties.length === 0) { %>
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
          <i class="fa-solid fa-hotel fa-3x text-muted mb-3 opacity-50"></i>
          <h5 class="fw-bold">No properties listed yet</h5>
          <p class="text-muted small">Start adding stays to your organization portfolio.</p>
          <div>
            <a href="/listings/new" class="btn btn-danger rounded-pill px-4 shadow-sm">+ Add First Property</a>
          </div>
        </div>
      <% } else { %>
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">
          <% for (let property of properties) { %>
            <div class="col">
              <div class="card listing-card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                <a href="/listings/<%= property._id %>" class="text-decoration-none text-dark">
                  <img src="<%= property.image && property.image.url ? property.image.url : 'https://images.unsplash.com/photo-1566073771259-6a8506099945' %>" 
                       class="card-img-top" 
                       alt="<%= property.title %>" 
                       style="height: 14rem; object-fit: cover;">
                  <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                      <h6 class="card-title fw-bold mb-0 text-truncate"><%= property.title %></h6>
                      <span class="badge bg-light text-dark border ms-2"><%= property.category || property.propertyType || "Stay" %></span>
                    </div>
                    <p class="text-muted small mb-2"><i class="fa-solid fa-location-dot text-danger me-1"></i><%= property.location %>, <%= property.country %></p>
                    <p class="fw-bold text-danger mb-0">&#8377; <%= (property.price || 0).toLocaleString("en-IN") %> <span class="text-muted fw-normal small">/ night</span></p>
                  </div>
                </a>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>

    </div>
  </div>
</div>
