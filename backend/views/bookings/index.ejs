<% layout('layouts/boilerplate') %>

<div class="container my-4">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
          <h2 class="fw-bold mb-1"><i class="fa-solid fa-suitcase text-danger me-2"></i>My Trips & Reservations</h2>
          <p class="text-muted small mb-0">View your upcoming and past bookings on WanderLust.</p>
        </div>
        <a href="/listings" class="btn btn-danger rounded-pill px-4">
          <i class="fa-solid fa-compass me-1"></i> Plan a New Trip
        </a>
      </div>

      <% if (bookings && bookings.length > 0) { %>
        <div class="row g-3">
          <% for (let b of bookings) { %>
            <div class="col-12">
              <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="row align-items-center g-3">
                  <div class="col-md-3">
                    <% const bImg = (b.property && b.property.image && b.property.image.url) ? b.property.image.url : 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=400&q=80'; %>
                    <img src="<%= bImg %>" class="rounded-3 w-100" style="height: 120px; object-fit: cover;" alt="<%= b.property ? b.property.title : 'Stay' %>">
                  </div>
                  <div class="col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-1">
                      <h5 class="fw-bold mb-0">
                        <a href="/listings/<%= b.property ? b.property._id : '#' %>" class="text-decoration-none text-dark">
                          <%= b.property ? b.property.title : 'Property' %>
                        </a>
                      </h5>
                      <span class="badge <%= b.status === 'CONFIRMED' ? 'bg-success' : (b.status === 'CANCELLED' ? 'bg-danger' : 'bg-secondary') %> rounded-pill">
                        <%= b.status %>
                      </span>
                    </div>
                    <p class="text-muted small mb-2">
                      <i class="fa-solid fa-location-dot text-danger me-1"></i><%= b.property ? b.property.location : '' %> &bull; Room <%= b.room ? b.room.roomNumber + ' (' + b.room.roomType + ')' : 'Standard' %>
                    </p>
                    <p class="mb-0 small text-secondary">
                      <i class="fa-regular fa-calendar me-1"></i>
                      <b><%= new Date(b.checkIn).toLocaleDateString("en-US", { month: 'short', day: 'numeric', year: 'numeric' }) %></b> &mdash; 
                      <b><%= new Date(b.checkOut).toLocaleDateString("en-US", { month: 'short', day: 'numeric', year: 'numeric' }) %></b> 
                      (<%= b.totalNights %> night<%= b.totalNights === 1 ? '' : 's' %>)
                    </p>
                  </div>
                  <div class="col-md-3 text-md-end">
                    <h5 class="fw-bold text-danger mb-2">&#8377; <%= Number(b.totalPrice).toLocaleString("en-IN") %></h5>
                    <div class="d-flex flex-md-column gap-2 justify-content-md-end">
                      <a href="/bookings/<%= b._id %>" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                        View Receipt
                      </a>
                      <% if (b.status !== 'CANCELLED') { %>
                        <form method="POST" action="/bookings/<%= b._id %>/cancel" onsubmit="return confirm('Cancel this booking?');">
                          <button class="btn btn-sm btn-outline-danger rounded-pill px-3 w-100">Cancel</button>
                        </form>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <div class="text-center py-5 my-4 bg-white rounded-4 shadow-sm p-4">
          <i class="fa-solid fa-plane-slash fa-3x text-muted opacity-50 mb-3"></i>
          <h4 class="fw-bold">No Bookings Yet</h4>
          <p class="text-muted">You haven't booked any stays yet. Explore our vacation homes, hostels, and resorts!</p>
          <a href="/listings" class="btn btn-danger rounded-pill px-4 mt-2">Explore Destinations</a>
        </div>
      <% } %>
    </div>
  </div>
</div>
