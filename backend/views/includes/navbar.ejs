<style>
.search-btn {
  background-color: #fe424d;
  color: #fff;
  border-radius: 25px;
  padding: 0.5rem 1.2rem;
  display: flex;
  align-items: center;
  gap: 0.4rem;
  white-space: nowrap;
}

.search-btn:hover {
  background-color: #d73b45;
  color: #fff;
}
.search-btn i {
  display: inline;
  margin-right: 0.25rem;
}
.search-inp {
  border-radius: 25px;
  padding: 0.5rem 1.5rem;
  font-size: 0.95rem;
  min-width: 260px;
}
.navbar-brand {
  color: #fe424d !important;
  font-size: 1.6rem;
}
.role-badge {
  font-size: 0.7rem;
  vertical-align: middle;
  margin-left: 0.25rem;
}
</style>

<nav class="navbar navbar-expand-md bg-white border-bottom sticky-top shadow-sm py-2">
  <div class="container-fluid px-md-4">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/listings">
      <i class="fa-regular fa-compass text-danger"></i>
      <span class="fw-bold fs-4 text-danger d-none d-sm-inline">WanderLust</span>
    </a>
    
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <!-- Left Navigation -->
      <div class="navbar-nav me-auto">
        <a class="nav-link fw-semibold" href="/listings"><i class="fa-solid fa-compass me-1"></i> Explore</a>
        <% if (currentUser && (currentUser.role === 'OWNER' || currentUser.role === 'ADMIN' || currentUser.role === 'MANAGER')) { %>
          <a class="nav-link fw-semibold text-primary" href="/dashboard"><i class="fa-solid fa-chart-line me-1"></i> Property Dashboard</a>
        <% } %>
        <% if (currentUser && currentUser.role === 'CUSTOMER') { %>
          <a class="nav-link fw-semibold" href="/bookings"><i class="fa-solid fa-suitcase me-1"></i> My Trips</a>
          <a class="nav-link fw-semibold" href="/dashboard"><i class="fa-solid fa-user me-1"></i> Dashboard</a>
        <% } %>
      </div>

      <!-- Functional Centered Search Form -->
      <div class="mx-auto my-2 my-md-0">
        <form class="d-flex" role="search" action="/listings" method="GET">
          <input 
            class="form-control me-2 search-inp" 
            type="search" 
            name="q" 
            placeholder="Search city, hostel, hotel, or country..." 
            value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" 
            aria-label="Search" 
          />
          <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i> Search
          </button>
        </form>
      </div>

      <!-- Right Navigation -->
      <div class="navbar-nav ms-auto align-items-md-center gap-1">
        <% if (currentUser && (currentUser.role === 'OWNER' || currentUser.role === 'ADMIN' || currentUser.role === 'MANAGER')) { %>
          <a class="nav-link fw-semibold" href="/listings/new">
            <i class="fa-solid fa-plus-circle text-danger me-1"></i> Add Property
          </a>
        <% } %>

        <% if (!currentUser) { %>
          <a class="nav-link" href="/signup"><b>Sign Up</b></a>
          <a class="nav-link" href="/login"><b>Log in</b></a>
        <% } else { %>
          <div class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-1 fw-bold text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fa-solid fa-circle-user fa-lg text-secondary"></i>
              <span>@<%= currentUser.username %></span>
              <span class="badge bg-danger role-badge"><%= currentUser.role %></span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
              <li><h6 class="dropdown-header">Logged in as <%= currentUser.username %></h6></li>
              <li><a class="dropdown-item" href="/dashboard"><i class="fa-solid fa-user me-2"></i>Dashboard</a></li>
              <li><a class="dropdown-item" href="/bookings"><i class="fa-solid fa-suitcase me-2"></i>My Trips</a></li>
              <% if (currentUser.role === 'OWNER' || currentUser.role === 'ADMIN' || currentUser.role === 'MANAGER') { %>
                <li><a class="dropdown-item" href="/listings/new"><i class="fa-solid fa-hotel me-2"></i>New Listing</a></li>
              <% } %>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item text-danger" href="/logout"><i class="fa-solid fa-right-from-bracket me-2"></i>Log out</a></li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>
