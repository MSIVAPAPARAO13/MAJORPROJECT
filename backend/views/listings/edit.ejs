<% layout('layouts/boilerplate') %>

<div class="row mt-4 mb-5 justify-content-center">
  <div class="col-lg-8 col-md-10">
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
      <h3 class="fw-bold mb-1"><i class="fa-solid fa-pen-to-square text-danger me-2"></i>Edit Property</h3>
      <p class="text-muted mb-4 small">Update property details, amenities, rates, and imagery.</p>

      <form method="post" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        
        <!-- Property Title -->
        <div class="mb-3">
          <label for="title" class="form-label fw-semibold">Title</label>
          <input type="text" id="title" name="listing[title]" value="<%= listing.title %>" class="form-control" required />
          <div class="invalid-feedback">Please enter a valid title.</div>
        </div>

        <!-- Description -->
        <div class="mb-3">
          <label for="description" class="form-label fw-semibold">Description</label>
          <textarea id="description" name="listing[description]" rows="4" class="form-control" required><%= listing.description %></textarea>
          <div class="invalid-feedback">Please enter a description.</div>
        </div>

        <!-- Property Type & Category -->
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="propertyType" class="form-label fw-semibold">Property Type</label>
            <select class="form-select" id="propertyType" name="listing[propertyType]">
              <% const pTypes = ["Hostel", "Hotel", "Apartment", "Guest House", "Resort", "Homestay"]; %>
              <% for (let pt of pTypes) { %>
                <option value="<%= pt %>" <%= listing.propertyType === pt ? 'selected' : '' %>><%= pt %></option>
              <% } %>
            </select>
          </div>
          <div class="col-md-6">
            <label for="category" class="form-label fw-semibold">Theme Category</label>
            <select class="form-select" id="category" name="listing[category]">
              <% const cats = ["Rooms", "Hostels", "Trending", "Iconic Cities", "Mountains", "Castles", "Amazing pool", "Camping", "Farms", "Arctic", "Domes", "Boats"]; %>
              <% for (let c of cats) { %>
                <option value="<%= c %>" <%= listing.category === c ? 'selected' : '' %>><%= c %></option>
              <% } %>
            </select>
          </div>
        </div>

        <!-- Current Image Preview & Upload Replacement -->
        <div class="mb-3">
          <label class="form-label fw-semibold d-block">Current Cover Image</label>
          <% if (originalImageUrl) { %>
            <img src="<%= originalImageUrl %>" class="rounded-3 mb-2 shadow-sm border" style="max-height: 160px; object-fit: cover;" alt="Listing Image" />
          <% } %>
          <label for="image" class="form-label small text-muted d-block">Upload Replacement Image (Optional)</label>
          <input type="file" id="image" name="listing[image]" class="form-control" accept="image/*" />
        </div>

        <!-- Price, Location, Country -->
        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <label for="price" class="form-label fw-semibold">Base Price per Night (&#8377;)</label>
            <input type="number" id="price" name="listing[price]" value="<%= listing.price %>" min="0" class="form-control" required />
            <div class="invalid-feedback">Price should be valid.</div>
          </div>
          <div class="col-md-4">
            <label for="location" class="form-label fw-semibold">Location / City</label>
            <input type="text" id="location" name="listing[location]" value="<%= listing.location %>" class="form-control" required />
            <div class="invalid-feedback">Location should be valid.</div>
          </div>
          <div class="col-md-4">
            <label for="country" class="form-label fw-semibold">Country</label>
            <input type="text" id="country" name="listing[country]" value="<%= listing.country %>" class="form-control" required />
            <div class="invalid-feedback">Country should be valid.</div>
          </div>
        </div>

        <!-- Amenities Selection -->
        <div class="mb-4">
          <label class="form-label fw-semibold d-block">Amenities Available</label>
          <div class="row g-2">
            <% const sampleAmenities = ["Free WiFi", "Air Conditioning", "Free Breakfast", "Swimming Pool", "Kitchen", "Free Parking", "Workspace", "Pet Friendly"]; %>
            <% for (let item of sampleAmenities) { %>
              <div class="col-md-3 col-6">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="listing[amenities]" value="<%= item %>" id="amenity_<%= item.replace(/\s+/g, '') %>" <%= listing.amenities && listing.amenities.includes(item) ? 'checked' : '' %>>
                  <label class="form-check-label small" for="amenity_<%= item.replace(/\s+/g, '') %>">
                    <%= item %>
                  </label>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Submit Controls -->
        <div class="d-flex justify-content-end gap-2">
          <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary px-4 rounded-pill">Cancel</a>
          <button class="btn btn-danger px-5 rounded-pill shadow-sm" type="submit">Update Property</button>
        </div>

      </form>
    </div>

    <!-- Phase 7: Property Image Gallery Management -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mt-4">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 pb-2 border-bottom">
        <div>
          <h4 class="fw-bold mb-1"><i class="fa-solid fa-images text-danger me-2"></i>Photo Gallery Management</h4>
          <p class="text-muted small mb-0">Manage gallery photos, set primary hero image, or upload new property photos.</p>
        </div>
        <span class="badge bg-danger rounded-pill px-3 py-2">
          <%= (listing.images && listing.images.length) || 0 %> Photos
        </span>
      </div>

      <!-- Upload New Images Form -->
      <form method="post" action="/listings/<%= listing._id %>/images" enctype="multipart/form-data" class="mb-4 p-3 bg-light rounded-3 border">
        <label for="galleryImages" class="form-label fw-semibold small">Upload Additional Photos (Max 10 at once)</label>
        <div class="input-group">
          <input type="file" id="galleryImages" name="images" class="form-control" accept="image/*" multiple required />
          <button class="btn btn-danger px-4" type="submit">
            <i class="fa-solid fa-cloud-arrow-up me-1"></i> Upload
          </button>
        </div>
        <small class="text-muted mt-1 d-block">Supported formats: JPG, PNG, WEBP.</small>
      </form>

      <!-- Existing Images Grid -->
      <% if (listing.images && listing.images.length > 0) { %>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
          <% for (let img of listing.images) { %>
            <div class="col">
              <div class="card h-100 border rounded-3 overflow-hidden position-relative shadow-sm">
                <img 
                  src="<%= img.url %>" 
                  class="card-img-top" 
                  alt="<%= img.alt || 'Property Image' %>" 
                  style="height: 160px; object-fit: cover;"
                  onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80';"
                />
                
                <% if (img.isPrimary) { %>
                  <div class="position-absolute top-0 start-0 m-2">
                    <span class="badge bg-success shadow-sm">
                      <i class="fa-solid fa-star me-1"></i>Primary Cover
                    </span>
                  </div>
                <% } %>

                <div class="card-body p-2 bg-white d-flex justify-content-between align-items-center">
                  <div>
                    <% if (!img.isPrimary) { %>
                      <form method="post" action="/listings/<%= listing._id %>/images/<%= img._id %>/primary?_method=PATCH" class="d-inline">
                        <button type="submit" class="btn btn-outline-primary btn-sm py-1 px-2 small rounded-pill">
                          <i class="fa-regular fa-star me-1"></i>Make Primary
                        </button>
                      </form>
                    <% } else { %>
                      <small class="text-success fw-bold ps-1"><i class="fa-solid fa-check me-1"></i>Active Cover</small>
                    <% } %>
                  </div>
                  <div>
                    <form method="post" action="/listings/<%= listing._id %>/images/<%= img._id %>?_method=DELETE" class="d-inline" onsubmit="return confirm('Delete this image?');">
                      <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-2 small rounded-pill">
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <p class="text-muted small mb-0">No photos currently stored for this property.</p>
      <% } %>

    </div>
  </div>
</div>
