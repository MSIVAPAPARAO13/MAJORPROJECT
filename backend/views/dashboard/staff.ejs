<% layout('layouts/boilerplate') %>

<div class="container my-4">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
      <h2 class="fw-bold mb-1"><i class="fa-solid fa-clipboard-user text-primary me-2"></i>Staff Operations Desk</h2>
      <p class="text-muted small mb-0">Daily guest turnover, real-time in-house occupancy, and property room readiness.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">Date: <%= data.operationalDate %></span>
    </div>
  </div>

  <!-- Operational Snapshot Cards (Strictly Operational - No Revenue/Financial Data) -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center border-start border-4 border-success">
        <span class="text-muted small text-uppercase fw-semibold">Today's Arrivals</span>
        <h3 class="fw-bold my-1 text-success"><%= data.summary.todayArrivalsCount %></h3>
        <small class="text-muted">Check-ins pending today</small>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center border-start border-4 border-danger">
        <span class="text-muted small text-uppercase fw-semibold">Today's Departures</span>
        <h3 class="fw-bold my-1 text-danger"><%= data.summary.todayDeparturesCount %></h3>
        <small class="text-muted">Check-outs due today</small>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center border-start border-4 border-info">
        <span class="text-muted small text-uppercase fw-semibold">In-House Guests</span>
        <h3 class="fw-bold my-1 text-info"><%= data.summary.inHouseGuestsCount %></h3>
        <small class="text-muted">Currently active stays</small>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center border-start border-4 border-warning">
        <span class="text-muted small text-uppercase fw-semibold">Maintenance</span>
        <h3 class="fw-bold my-1 text-warning"><%= data.summary.maintenanceRoomsCount %></h3>
        <small class="text-muted"><%= data.summary.availableRoomsCount %> Available / <%= data.summary.totalRoomsCount %> Total</small>
      </div>
    </div>
  </div>

  <!-- Operational Task Tables -->
  <div class="row g-4 mb-4">
    <!-- Today's Arrivals -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="fw-bold mb-0 text-success"><i class="fa-solid fa-plane-arrival me-2"></i>Arrivals Today</h5>
          <span class="badge bg-success-subtle text-success rounded-pill"><%= data.todayArrivals.length %> arrivals</span>
        </div>
        <% if (data.todayArrivals && data.todayArrivals.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Guest</th>
                  <th>Property / Room</th>
                  <th>Check-In Time</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% for (let b of data.todayArrivals) { %>
                  <tr>
                    <td>
                      <span class="fw-semibold"><%= b.guest ? b.guest.username : (b.guestDetails ? b.guestDetails.name : 'Guest') %></span>
                      <small class="text-muted d-block"><%= b.guest ? b.guest.email : '' %></small>
                    </td>
                    <td>
                      <span class="d-block text-truncate" style="max-width: 180px;"><%= b.property ? b.property.title : 'Property' %></span>
                      <small class="badge bg-light text-dark border">
                        Room <%= b.room ? b.room.roomNumber : 'N/A' %> (<%= b.room ? b.room.roomType : 'Standard' %>)
                      </small>
                    </td>
                    <td><small class="font-monospace"><%= new Date(b.checkIn).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></small></td>
                    <td>
                      <span class="badge <%= b.status === 'CONFIRMED' ? 'bg-success' : 'bg-warning text-dark' %>"><%= b.status %></span>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="text-muted text-center py-4 mb-0">No guest arrivals scheduled for today.</p>
        <% } %>
      </div>
    </div>

    <!-- Today's Departures -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="fw-bold mb-0 text-danger"><i class="fa-solid fa-plane-departure me-2"></i>Departures Today</h5>
          <span class="badge bg-danger-subtle text-danger rounded-pill"><%= data.todayDepartures.length %> departures</span>
        </div>
        <% if (data.todayDepartures && data.todayDepartures.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Guest</th>
                  <th>Property / Room</th>
                  <th>Check-Out Time</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% for (let b of data.todayDepartures) { %>
                  <tr>
                    <td>
                      <span class="fw-semibold"><%= b.guest ? b.guest.username : (b.guestDetails ? b.guestDetails.name : 'Guest') %></span>
                      <small class="text-muted d-block"><%= b.guest ? b.guest.email : '' %></small>
                    </td>
                    <td>
                      <span class="d-block text-truncate" style="max-width: 180px;"><%= b.property ? b.property.title : 'Property' %></span>
                      <small class="badge bg-light text-dark border">
                        Room <%= b.room ? b.room.roomNumber : 'N/A' %> (<%= b.room ? b.room.roomType : 'Standard' %>)
                      </small>
                    </td>
                    <td><small class="font-monospace"><%= new Date(b.checkOut).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></small></td>
                    <td>
                      <span class="badge <%= b.status === 'CONFIRMED' ? 'bg-success' : 'bg-warning text-dark' %>"><%= b.status %></span>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="text-muted text-center py-4 mb-0">No guest departures scheduled for today.</p>
        <% } %>
      </div>
    </div>
  </div>

  <!-- In-House Stays & Maintenance -->
  <div class="row g-4 mb-4">
    <!-- In-House Guests -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <h5 class="fw-bold mb-3"><i class="fa-solid fa-bed text-info me-2"></i>Current In-House Stays</h5>
        <% if (data.inHouseBookings && data.inHouseBookings.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Guest</th>
                  <th>Property / Room</th>
                  <th>Stay Duration</th>
                  <th>Departure Date</th>
                </tr>
              </thead>
              <tbody>
                <% for (let b of data.inHouseBookings) { %>
                  <tr>
                    <td>
                      <span class="fw-semibold"><%= b.guest ? b.guest.username : (b.guestDetails ? b.guestDetails.name : 'Guest') %></span>
                      <small class="text-muted d-block"><%= b.guest ? b.guest.email : '' %></small>
                    </td>
                    <td>
                      <span class="fw-semibold"><%= b.property ? b.property.title : 'Property' %></span>
                      <small class="badge bg-light text-dark border d-inline-block">
                        Room <%= b.room ? b.room.roomNumber : 'N/A' %>
                      </small>
                    </td>
                    <td>
                      <small><%= new Date(b.checkIn).toLocaleDateString() %> &rarr; <%= new Date(b.checkOut).toLocaleDateString() %></small>
                    </td>
                    <td>
                      <span class="badge bg-info text-dark">Departs: <%= new Date(b.checkOut).toLocaleDateString() %></span>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="text-muted text-center py-3 mb-0">No guests currently checked in.</p>
        <% } %>
      </div>
    </div>

    <!-- Maintenance Issues -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <h5 class="fw-bold mb-3 text-warning"><i class="fa-solid fa-wrench me-2"></i>Rooms in Maintenance</h5>
        <% if (data.maintenanceRooms && data.maintenanceRooms.length > 0) { %>
          <ul class="list-group list-group-flush">
            <% for (let r of data.maintenanceRooms) { %>
              <li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                <div>
                  <span class="fw-semibold">Room <%= r.roomNumber %></span> (<%= r.roomType %>)
                  <small class="text-muted d-block"><%= r.property ? r.property.title : 'Property' %></small>
                </div>
                <span class="badge bg-warning text-dark">MAINTENANCE</span>
              </li>
            <% } %>
          </ul>
        <% } else { %>
          <p class="text-muted text-center py-3 mb-0">All rooms operational. Zero maintenance issues reported.</p>
        <% } %>
      </div>
    </div>
  </div>
</div>
