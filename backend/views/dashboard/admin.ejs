<% layout('layouts/boilerplate') %>

<div class="container my-4">
  <!-- Header & Date Filter -->
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
      <h2 class="fw-bold mb-1"><i class="fa-solid fa-shield-halved text-danger me-2"></i>Platform Administration</h2>
      <p class="text-muted small mb-0">System-wide multi-tenant hospitality monitoring and platform metrics.</p>
    </div>
    
    <!-- Filter Presets Form -->
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2 fw-semibold">SUPERADMIN MODE</span>
      <form method="GET" action="/dashboard" class="d-flex gap-1">
        <select name="preset" class="form-select form-select-sm rounded-pill shadow-sm" onchange="this.form.submit()">
          <option value="today" <%= (query && query.preset === 'today') ? 'selected' : '' %>>Today</option>
          <option value="7d" <%= (query && query.preset === '7d') ? 'selected' : '' %>>Last 7 Days</option>
          <option value="30d" <%= (!query || !query.preset || query.preset === '30d') ? 'selected' : '' %>>Last 30 Days</option>
          <option value="90d" <%= (query && query.preset === '90d') ? 'selected' : '' %>>Last 90 Days</option>
          <option value="all" <%= (query && query.preset === 'all') ? 'selected' : '' %>>All Time</option>
        </select>
      </form>
    </div>
  </div>

  <!-- Platform Overview KPI Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
        <span class="text-muted small text-uppercase fw-semibold">Organizations</span>
        <h3 class="fw-bold my-1 text-primary"><%= data.platformKPIs.totalOrganizations %></h3>
        <small class="text-muted"><%= data.platformKPIs.totalUsers %> Platform Users</small>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
        <span class="text-muted small text-uppercase fw-semibold">Properties & Rooms</span>
        <h3 class="fw-bold my-1 text-dark"><%= data.platformKPIs.totalProperties %></h3>
        <small class="text-muted"><%= data.platformKPIs.totalRooms %> Total Rooms</small>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
        <span class="text-muted small text-uppercase fw-semibold">Total Bookings</span>
        <h3 class="fw-bold my-1 text-info"><%= data.platformKPIs.totalBookings %></h3>
        <small class="text-muted"><%= data.bookingStatusBreakdown.CONFIRMED + data.bookingStatusBreakdown.COMPLETED %> Confirmed/Done</small>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
        <span class="text-muted small text-uppercase fw-semibold">Confirmed Booking Value</span>
        <h3 class="fw-bold my-1 text-success">&#8377; <%= Number(data.platformKPIs.confirmedCompletedValue || 0).toLocaleString("en-IN") %></h3>
        <small class="text-muted">&#8377; <%= Number(data.platformKPIs.pendingPipelineValue || 0).toLocaleString("en-IN") %> Pending Pipeline</small>
      </div>
    </div>
  </div>

  <!-- Booking Status Breakdown Cards -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
        <span class="badge bg-warning text-dark mx-auto mb-1">PENDING</span>
        <h4 class="fw-bold mb-0 text-warning"><%= data.bookingStatusBreakdown.PENDING %></h4>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
        <span class="badge bg-success mx-auto mb-1">CONFIRMED</span>
        <h4 class="fw-bold mb-0 text-success"><%= data.bookingStatusBreakdown.CONFIRMED %></h4>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
        <span class="badge bg-info text-dark mx-auto mb-1">COMPLETED</span>
        <h4 class="fw-bold mb-0 text-info"><%= data.bookingStatusBreakdown.COMPLETED %></h4>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
        <span class="badge bg-danger mx-auto mb-1">CANCELLED</span>
        <h4 class="fw-bold mb-0 text-danger"><%= data.bookingStatusBreakdown.CANCELLED %></h4>
      </div>
    </div>
  </div>

  <!-- Bounded Organization Performance Table (Rule 9) -->
  <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h5 class="fw-bold mb-0">Organization Performance</h5>
        <small class="text-muted">Top active hospitality organizations during selected period (Bounded to 25 records max)</small>
      </div>
    </div>

    <% if (data.organizationPerformance && data.organizationPerformance.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Organization</th>
              <th>Contact</th>
              <th class="text-center">Properties</th>
              <th class="text-center">Rooms</th>
              <th class="text-center">Bookings</th>
              <th class="text-end">Confirmed Booking Value</th>
              <th class="text-end">Pending Pipeline</th>
            </tr>
          </thead>
          <tbody>
            <% for (let org of data.organizationPerformance) { %>
              <tr>
                <td><span class="fw-bold text-dark"><%= org.name %></span></td>
                <td><small class="text-muted"><%= org.contactEmail || 'N/A' %></small></td>
                <td class="text-center"><span class="badge bg-light text-dark border"><%= org.propertyCount %></span></td>
                <td class="text-center"><span class="badge bg-light text-dark border"><%= org.roomCount %></span></td>
                <td class="text-center"><span class="badge bg-primary rounded-pill"><%= org.bookingCount %></span></td>
                <td class="text-end fw-semibold text-success">&#8377; <%= Number(org.confirmedValue || 0).toLocaleString("en-IN") %></td>
                <td class="text-end text-muted">&#8377; <%= Number(org.pendingValue || 0).toLocaleString("en-IN") %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="text-muted text-center py-4 mb-0">No active organizations recorded on the platform.</p>
    <% } %>
  </div>

  <!-- Recent System-Wide Activity -->
  <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="fw-bold mb-0">Recent Platform Bookings</h5>
      <small class="text-muted">Latest 10 reservations across all tenants</small>
    </div>
    <% if (data.recentPlatformBookings && data.recentPlatformBookings.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Ref</th>
              <th>Tenant Org</th>
              <th>Property</th>
              <th>Guest</th>
              <th>Dates</th>
              <th>Booking Value</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% for (let b of data.recentPlatformBookings) { %>
              <tr>
                <td><span class="font-monospace small">#<%= b._id.toString().substring(18) %></span></td>
                <td><small class="fw-semibold text-primary"><%= b.organization ? b.organization.name : 'Unknown' %></small></td>
                <td><%= b.property ? b.property.title : 'Property' %></td>
                <td><%= b.guest ? b.guest.username : (b.guestDetails ? b.guestDetails.name : 'User') %></td>
                <td><small><%= new Date(b.checkIn).toLocaleDateString() %> &rarr; <%= new Date(b.checkOut).toLocaleDateString() %></small></td>
                <td><b>&#8377; <%= Number(b.totalPrice).toLocaleString("en-IN") %></b></td>
                <td>
                  <span class="badge <%= b.status === 'CONFIRMED' ? 'bg-success' : (b.status === 'CANCELLED' ? 'bg-danger' : 'bg-secondary') %>">
                    <%= b.status %>
                  </span>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="text-muted mb-0 py-3 text-center">No platform bookings recorded yet.</p>
    <% } %>
  </div>
</div>
