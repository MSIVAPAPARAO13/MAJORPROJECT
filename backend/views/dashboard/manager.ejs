<% layout('layouts/boilerplate') %>

<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
      <h2 class="fw-bold mb-1"><i class="fa-solid fa-building-user text-info me-2"></i>Property Operations</h2>
      <p class="text-muted small mb-0">Your assigned organization overview &mdash; rooms, bookings, and operational status.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <% const presets = ['today','7d','30d','90d','all']; %>
      <% presets.forEach(p => { %>
        <a href="/manager/dashboard?preset=<%= p %>" class="btn btn-sm <%= (query.preset || '30d') === p ? 'btn-primary' : 'btn-outline-secondary' %> rounded-pill">
          <%= p === 'today' ? 'Today' : p === '7d' ? '7 Days' : p === '30d' ? '30 Days' : p === '90d' ? '90 Days' : 'All Time' %>
        </a>
      <% }); %>
    </div>
  </div>

  <% if (data.organization) { %>
  <div class="alert alert-light border mb-4 rounded-3 d-flex align-items-center gap-3">
    <i class="fa-solid fa-building text-info fa-2x"></i>
    <div>
      <h6 class="fw-bold mb-0"><%= data.organization.name %></h6>
      <small class="text-muted">Your assigned organization</small>
    </div>
  </div>
  <% } %>

  <!-- KPI Row -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
        <span class="text-muted small text-uppercase fw-semibold">Properties</span>
        <h3 class="fw-bold my-1 text-primary"><%= data.totalListings || 0 %></h3>
        <small class="text-muted">In your organization</small>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
        <span class="text-muted small text-uppercase fw-semibold">Rooms</span>
        <h3 class="fw-bold my-1 text-info"><%= data.totalRooms || 0 %></h3>
        <small class="text-muted"><%= data.availableRooms || 0 %> available</small>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
        <span class="text-muted small text-uppercase fw-semibold">Bookings (<%= data.periodLabel || '30d' %>)</span>
        <h3 class="fw-bold my-1 text-success"><%= data.totalBookings || 0 %></h3>
        <small class="text-muted"><%= data.confirmedBookings || 0 %> confirmed</small>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
        <span class="text-muted small text-uppercase fw-semibold">Open Issues</span>
        <h3 class="fw-bold my-1 <%= (data.openIssues || 0) > 0 ? 'text-danger' : 'text-success' %>"><%= data.openIssues || 0 %></h3>
        <small class="text-muted">Unresolved service issues</small>
      </div>
    </div>
  </div>

  <!-- Booking Value -->
  <% if (data.confirmedBookingValue !== undefined) { %>
  <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
    <h5 class="fw-bold mb-3"><i class="fa-solid fa-chart-line text-info me-2"></i>Period Revenue Summary</h5>
    <div class="row g-3">
      <div class="col-sm-6">
        <div class="rounded-3 bg-success bg-opacity-10 p-3">
          <small class="text-muted d-block">Confirmed Booking Value</small>
          <h4 class="fw-bold text-success mb-0">&#8377;<%= (data.confirmedBookingValue || 0).toLocaleString('en-IN') %></h4>
        </div>
      </div>
      <div class="col-sm-6">
        <div class="rounded-3 bg-warning bg-opacity-10 p-3">
          <small class="text-muted d-block">Pending Booking Value</small>
          <h4 class="fw-bold text-warning mb-0">&#8377;<%= (data.pendingBookingValue || 0).toLocaleString('en-IN') %></h4>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Quick Actions -->
  <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
    <h5 class="fw-bold mb-3"><i class="fa-solid fa-bolt text-warning me-2"></i>Quick Actions</h5>
    <div class="d-flex flex-wrap gap-2">
      <a href="/manager/operations" class="btn btn-outline-warning rounded-pill"><i class="fa-solid fa-clipboard-user me-1"></i>Operations Center</a>
      <a href="/listings" class="btn btn-outline-primary rounded-pill"><i class="fa-solid fa-hotel me-1"></i>View Properties</a>
      <a href="/listings/new" class="btn btn-danger rounded-pill"><i class="fa-solid fa-plus me-1"></i>Add Property</a>
    </div>
  </div>
</div>
