<% layout('layouts/boilerplate') %>
<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
      <h2 class="fw-bold mb-1"><i class="fa-solid fa-shield-halved text-danger me-2"></i>Platform Operations</h2>
      <p class="text-muted small mb-0">Real-time operational view for Admin.</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
      <span class="badge bg-danger rounded-pill px-3 py-2"><i class="fa-solid fa-circle-dot me-1"></i> Live</span>
      <span class="badge bg-light text-dark border rounded-pill px-3 py-2"><%= new Date().toLocaleDateString('en-IN', {weekday:'short',day:'numeric',month:'short'}) %></span>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3"><div class="card border-0 shadow-sm rounded-4 p-3 text-center"><span class="text-muted small text-uppercase fw-semibold">Organizations</span><h3 class="fw-bold my-1 text-primary"><%= data.totalOrganizations || 0 %></h3></div></div>
    <div class="col-sm-6 col-lg-3"><div class="card border-0 shadow-sm rounded-4 p-3 text-center"><span class="text-muted small text-uppercase fw-semibold">Total Users</span><h3 class="fw-bold my-1 text-info"><%= data.totalUsers || 0 %></h3></div></div>
    <div class="col-sm-6 col-lg-3"><div class="card border-0 shadow-sm rounded-4 p-3 text-center"><span class="text-muted small text-uppercase fw-semibold">Properties</span><h3 class="fw-bold my-1 text-success"><%= data.totalListings || 0 %></h3></div></div>
    <div class="col-sm-6 col-lg-3"><div class="card border-0 shadow-sm rounded-4 p-3 text-center"><span class="text-muted small text-uppercase fw-semibold">Total Rooms</span><h3 class="fw-bold my-1 text-secondary"><%= data.totalRooms || 0 %></h3></div></div>
  </div>
  <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
    <h5 class="fw-bold mb-3"><i class="fa-solid fa-bolt text-warning me-2"></i>Admin Quick Actions</h5>
    <div class="d-flex flex-wrap gap-2">
      <a href="/admin/dashboard" class="btn btn-outline-danger rounded-pill"><i class="fa-solid fa-shield-halved me-1"></i>Admin Dashboard</a>
      <a href="/organizations/new" class="btn btn-outline-primary rounded-pill"><i class="fa-solid fa-building me-1"></i>Register Organization</a>
      <a href="/listings" class="btn btn-outline-secondary rounded-pill"><i class="fa-solid fa-hotel me-1"></i>All Properties</a>
      <a href="/listings/new" class="btn btn-danger rounded-pill"><i class="fa-solid fa-plus me-1"></i>Add Property</a>
    </div>
  </div>
  <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
    <h5 class="fw-bold mb-3"><i class="fa-solid fa-heartbeat text-danger me-2"></i>System Health</h5>
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-success px-3 py-2 rounded-pill"><i class="fa-solid fa-circle me-1"></i>Database Connected</span>
      <span class="text-muted small">Atlas MongoDB — wanderlust</span>
    </div>
  </div>
</div>
