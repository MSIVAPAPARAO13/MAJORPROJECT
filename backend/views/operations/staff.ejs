<% layout('layouts/boilerplate') %>
<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
      <h2 class="fw-bold mb-1"><i class="fa-solid fa-clipboard-user text-warning me-2"></i>Operations Center</h2>
      <p class="text-muted small mb-0">Real-time operational view for Staff.</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
      <span class="badge bg-warning rounded-pill px-3 py-2"><i class="fa-solid fa-circle-dot me-1"></i> Live</span>
      <span class="badge bg-light text-dark border rounded-pill px-3 py-2"><%= new Date().toLocaleDateString('en-IN', {weekday:'short',day:'numeric',month:'short'}) %></span>
    </div>
  </div>

  <!-- Summary KPIs -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
        <span class="text-muted small text-uppercase fw-semibold">Arrivals Today</span>
        <h3 class="fw-bold my-1 text-success"><%= data.summary.todayArrivalsCount %></h3>
        <small class="text-muted">Check-ins pending</small>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
        <span class="text-muted small text-uppercase fw-semibold">Departures Today</span>
        <h3 class="fw-bold my-1 text-danger"><%= data.summary.todayDeparturesCount %></h3>
        <small class="text-muted">Check-outs due</small>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
        <span class="text-muted small text-uppercase fw-semibold">In-House Guests</span>
        <h3 class="fw-bold my-1 text-info"><%= data.summary.inHouseGuestsCount %></h3>
        <small class="text-muted">Currently active</small>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
        <span class="text-muted small text-uppercase fw-semibold">Maintenance</span>
        <h3 class="fw-bold my-1 text-warning"><%= data.summary.maintenanceRoomsCount %></h3>
        <small class="text-muted"><%= data.summary.availableRoomsCount %> of <%= data.summary.totalRoomsCount %> available</small>
      </div>
    </div>
  </div>

  <% if (data.guestImpactAlerts && data.guestImpactAlerts.length > 0) { %>
  <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 border-start border-4 border-danger">
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
      <h5 class="fw-bold mb-0 text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>Guest Impact Alerts (<%= data.guestImpactAlerts.length %>)</h5>
      <span class="badge bg-danger rounded-pill">Action Required Before Check-In</span>
    </div>
    <p class="text-muted small mb-3">Upcoming check-ins with unresolved service issues in their assigned rooms.</p>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Severity</th><th>Guest</th><th>Property / Room</th><th>Check-In</th><th>Issue</th><th class="text-end">Action</th></tr></thead>
        <tbody>
          <% for (let a of data.guestImpactAlerts) { %>
          <tr>
            <td><span class="badge <%= a.severity === 'HIGH' ? 'bg-danger' : a.severity === 'MEDIUM' ? 'bg-warning text-dark' : 'bg-info text-dark' %>"><%= a.severity %></span></td>
            <td><span class="fw-semibold"><%= a.guestName %></span><small class="text-muted d-block"><%= a.bookingNumber %></small></td>
            <td><%= a.propertyTitle %><br><small class="badge bg-light text-dark border">Room <%= a.roomNumber %></small></td>
            <td><small class="font-monospace fw-semibold"><%= a.checkInFormatted %></small></td>
            <td><span class="fw-semibold"><%= a.issueTitle %></span><small class="d-block text-muted">Status: <%= a.issueStatus %></small></td>
            <td class="text-end"><a href="/listings/<%= a.propertyId %>/rooms/<%= a.roomId %>/issues/<%= a.issueId %>" class="btn btn-sm btn-outline-danger rounded-pill">View Issue</a></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  <div class="row g-4 mb-4">
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
        <h5 class="fw-bold mb-3 text-success"><i class="fa-solid fa-plane-arrival me-2"></i>Arrivals Today</h5>
        <% if (data.todayArrivals && data.todayArrivals.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Guest</th><th>Property / Room</th><th>Status</th></tr></thead>
            <tbody>
              <% for (let b of data.todayArrivals) { %>
              <tr>
                <td><span class="fw-semibold"><%= b.guest ? b.guest.username : 'Guest' %></span><small class="text-muted d-block"><%= b.guest ? b.guest.email : '' %></small></td>
                <td><span><%= b.property ? b.property.title : 'Property' %></span><small class="badge bg-light text-dark border d-block mt-1">Room <%= b.room ? b.room.roomNumber : 'N/A' %></small></td>
                <td><span class="badge <%= b.status === 'CONFIRMED' ? 'bg-success' : 'bg-warning text-dark' %>"><%= b.status %></span></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <% } else { %><p class="text-muted text-center py-4 mb-0">No arrivals today.</p><% } %>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
        <h5 class="fw-bold mb-3 text-danger"><i class="fa-solid fa-plane-departure me-2"></i>Departures Today</h5>
        <% if (data.todayDepartures && data.todayDepartures.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Guest</th><th>Property / Room</th><th>Status</th></tr></thead>
            <tbody>
              <% for (let b of data.todayDepartures) { %>
              <tr>
                <td><span class="fw-semibold"><%= b.guest ? b.guest.username : 'Guest' %></span><small class="text-muted d-block"><%= b.guest ? b.guest.email : '' %></small></td>
                <td><span><%= b.property ? b.property.title : 'Property' %></span><small class="badge bg-light text-dark border d-block mt-1">Room <%= b.room ? b.room.roomNumber : 'N/A' %></small></td>
                <td><span class="badge <%= b.status === 'CONFIRMED' ? 'bg-success' : 'bg-warning text-dark' %>"><%= b.status %></span></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <% } else { %><p class="text-muted text-center py-4 mb-0">No departures today.</p><% } %>
      </div>
    </div>
  </div>

  <% if (data.activeServiceIssues && data.activeServiceIssues.length > 0) { %>
  <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
    <h5 class="fw-bold mb-3"><i class="fa-solid fa-screwdriver-wrench text-primary me-2"></i>Active Service Issues (<%= data.activeServiceIssues.length %>)</h5>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Priority</th><th>Property / Room</th><th>Issue</th><th>Status</th><th class="text-end">Action</th></tr></thead>
        <tbody>
          <% for (let issue of data.activeServiceIssues) { %>
          <tr>
            <td><span class="badge <%= issue.priority === 'HIGH' ? 'bg-danger' : issue.priority === 'MEDIUM' ? 'bg-warning text-dark' : 'bg-info text-dark' %>"><%= issue.priority %></span></td>
            <td><span class="fw-semibold"><%= issue.property ? issue.property.title : 'Property' %></span><small class="badge bg-light text-dark border d-block mt-1">Room <%= issue.room ? issue.room.roomNumber : 'N/A' %></small></td>
            <td><span class="fw-semibold"><%= issue.title %></span></td>
            <td><span class="badge <%= issue.status === 'IN_PROGRESS' ? 'bg-primary' : issue.status === 'ASSIGNED' ? 'bg-info text-dark' : 'bg-secondary' %>"><%= issue.status %></span></td>
            <td class="text-end">
              <% if (issue.property && issue.room) { %>
              <a href="/listings/<%= issue.property._id %>/rooms/<%= issue.room._id %>/issues/<%= issue._id %>" class="btn btn-sm btn-outline-secondary rounded-pill me-1">Details</a>
              <form action="/listings/<%= issue.property._id %>/rooms/<%= issue.room._id %>/issues/<%= issue._id %>/resolve" method="POST" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill">Resolve</button>
              </form>
              <% } %>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>
</div>
